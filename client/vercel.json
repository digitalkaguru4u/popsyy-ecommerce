{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://popsyy-ecommerce.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://popsyy-ecommerce.onrender.com/uploads/:path*" },
    { "source": "/sitemap.xml", "destination": "https://popsyy-ecommerce.onrender.com/sitemap.xml" },
    { "source": "/((?!assets/|images/|favicon.svg|robots.txt).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
